---
import BookingWidget from '@obrim/ui/components/BookingWidget';
import OrderWidget from '@obrim/ui/components/OrderWidget';
import LangSwitcher from '@obrim/ui/components/LangSwitcher.astro';
import ObrimBadge from '@obrim/ui/components/ObrimBadge.astro';
import WhatsAppButton from '@obrim/ui/components/WhatsAppButton.astro';
import { HTML_LANG, formatPrice, type Lang } from '@obrim/ui/i18n';
import Base from '../layouts/Base.astro';
import { useDictionary } from '../i18n';
import { experiencesFor, visitLanguagesFor } from '../data/experiences';
import { shopFor } from '../data/wines';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useDictionary(lang);
const BRAND = 'Celler Mas Albareda';
const ADDRESS = 'Camí de les Vinyes, s/n, 08796 Pacs del Penedès';
const mapsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(ADDRESS)}`;
const experiences = experiencesFor(lang);
const visitLanguages = visitLanguagesFor(lang);
const shop = shopFor(lang);
/** Visitas cada día, última a las 16:00 (slots de 60 min hasta las 17:00) */
const hours = { start: '10:00', end: '17:00', closedDays: [] as number[] };

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['Winery', 'TouristAttraction'],
  name: BRAND,
  address: { '@type': 'PostalAddress', streetAddress: 'Camí de les Vinyes, s/n', addressLocality: 'Pacs del Penedès', postalCode: '08796', addressRegion: 'Barcelona', addressCountry: 'ES' },
  priceRange: '€€',
  availableLanguage: ['ca', 'es', 'en'],
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'], opens: '10:00', closes: '17:00' },
  ],
  makesOffer: experiences.map((e) => ({
    '@type': 'Offer',
    name: e.name,
    price: e.price,
    priceCurrency: 'EUR',
    itemOffered: { '@type': 'TouristTrip', name: e.name, description: e.description },
  })),
};

const nav = [
  ['#visites', t.nav.experiences],
  ['#vins', t.nav.shop],
  ['#reserva', t.nav.book],
  ['#on-som', t.nav.info],
];
---

<Base lang={lang} title={t.meta.title} description={t.meta.description} jsonLd={jsonLd}>
  <header class="sticky top-0 z-30 border-b border-line/70 bg-paper/90 backdrop-blur">
    <div class="container-x flex h-16 items-center justify-between gap-4">
      <a href="#top" class="font-display text-2xl font-semibold tracking-tight text-accent">{BRAND}</a>
      <nav class="hidden items-center gap-6 text-sm text-muted md:flex">
        {nav.map(([href, label]) => <a href={href} class="hover:text-ink">{label}</a>)}
      </nav>
      <div class="flex items-center gap-3">
        <LangSwitcher current={lang} path="/" />
        <a href="#reserva" class="btn-primary hidden !px-4 !py-2 sm:inline-flex">{t.hero.cta}</a>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="container-x grid gap-10 py-14 sm:py-20 lg:grid-cols-[1.1fr_1fr] lg:items-center">
      <div>
        <p class="eyebrow">{t.hero.eyebrow}</p>
        <h1 class="h-display mt-4">{t.hero.title}</h1>
        <p class="mt-6 max-w-lg text-lg text-muted">{t.hero.subtitle}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#reserva" class="btn-primary">{t.hero.cta}</a>
          <a href="#vins" class="btn-secondary">{t.hero.secondary}</a>
        </div>
        <p class="mt-6 inline-flex items-center gap-2 text-sm text-muted">
          <span aria-hidden="true" class="h-2 w-2 rounded-full bg-accent"></span>
          {t.hero.hours}
        </p>
      </div>
      <!-- TODO: sustituir por fotografía real de las viñas / el celler (ratio 4:5) -->
      <div class="relative aspect-[4/5] w-full max-w-md overflow-hidden rounded-card bg-accent lg:justify-self-end" aria-hidden="true">
        <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(255,255,255,0.22),transparent_45%),repeating-linear-gradient(100deg,transparent_0_26px,rgba(0,0,0,0.08)_26px_28px)]"></div>
        <div class="absolute inset-x-6 bottom-6 rounded-xl bg-paper/95 p-4 text-sm">
          <p class="eyebrow">{t.experiences.eyebrow}</p>
          <p class="mt-1 font-display text-lg">{experiences[1].name}</p>
          <p class="text-muted">
            {experiences[1].durationMinutes} {t.experiences.minutes} · {formatPrice(experiences[1].price, lang)} {t.experiences.perPerson}
          </p>
        </div>
      </div>
    </section>

    <section id="visites" class="border-y border-line bg-surface py-14 sm:py-20">
      <div class="container-x">
        <div class="max-w-2xl">
          <p class="eyebrow">{t.experiences.eyebrow}</p>
          <h2 class="h-section mt-3">{t.experiences.title}</h2>
          <p class="mt-3 text-muted">{t.experiences.body}</p>
        </div>
        <ul class="mt-10 grid gap-4 md:grid-cols-2">
          {
            experiences.map((e) => (
              <li class="card flex flex-col p-6">
                <div class="flex items-start justify-between gap-4">
                  <h3 class="font-display text-2xl">{e.name}</h3>
                  <p class="shrink-0 text-right">
                    <span class="block font-display text-2xl font-semibold tabular-nums">{formatPrice(e.price, lang)}</span>
                    <span class="text-xs text-muted">{t.experiences.perPerson}</span>
                  </p>
                </div>
                <p class="mt-1 text-sm text-muted">
                  {e.durationMinutes} {t.experiences.minutes}
                </p>
                <p class="mt-4 flex-1 text-muted">{e.description}</p>
                <ul class="mt-4 flex flex-wrap gap-2">{e.highlights.map((h) => <li class="pill">{h}</li>)}</ul>
                <a href="#reserva" class="btn-secondary mt-6 self-start">
                  {t.experiences.book}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section id="reserva" class="container-x grid gap-10 py-14 sm:py-20 lg:grid-cols-[1fr_1.3fr]">
      <div>
        <p class="eyebrow">{t.book.eyebrow}</p>
        <h2 class="h-section mt-3">{t.book.title}</h2>
        <p class="mt-3 text-muted">{t.book.body}</p>
        <div class="mt-8 border-t border-line pt-6">
          <h3 class="font-semibold">{t.policy.title}</h3>
          <ul class="mt-3 grid gap-2 text-sm text-muted">
            {
              t.policy.items.map((p) => (
                <li class="flex gap-2">
                  <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
                  {p}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <BookingWidget
        client:visible
        mode="experience"
        brand={BRAND}
        locale={HTML_LANG[lang]}
        labels={t.booking}
        hours={hours}
        slotMinutes={60}
        services={experiences}
        maxGuests={12}
        guaranteeFrom={120}
        visitLanguages={visitLanguages}
      />
    </section>

    <section id="vins" class="border-y border-line bg-accent-soft/40 py-14 sm:py-20">
      <div class="container-x">
        <div class="max-w-2xl">
          <p class="eyebrow">{t.shop.eyebrow}</p>
          <h2 class="h-section mt-3">{t.shop.title}</h2>
          <p class="mt-3 text-muted">{t.shop.body}</p>
        </div>
        <div class="mt-10">
          <OrderWidget
            client:visible
            brand={BRAND}
            locale={HTML_LANG[lang]}
            labels={t.order}
            categories={shop.categories}
            items={shop.items}
            allergenNames={shop.allergenNames}
            hours={hours}
            pickupStepMinutes={30}
          />
        </div>
      </div>
    </section>

    <section class="container-x py-14">
      <p class="eyebrow">{t.reviews.eyebrow}</p>
      <ul class="mt-6 grid gap-6 md:grid-cols-3">
        {
          t.reviews.items.map((r) => (
            <li class="card p-5">
              <p class="text-accent" aria-label="5/5">★★★★★</p>
              <p class="mt-3">{r.text}</p>
              <p class="mt-3 text-sm text-muted">
                {r.author} · {r.source}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="on-som" class="border-t border-line bg-surface">
      <div class="container-x grid gap-10 py-14 sm:py-20 md:grid-cols-3">
        <div>
          <p class="eyebrow">{t.info.eyebrow}</p>
          <h2 class="h-section mt-3">{t.info.title}</h2>
          <p class="mt-3 text-muted">{t.info.transport}</p>
          <a href={mapsHref} target="_blank" rel="noopener" class="btn-secondary mt-5">{t.info.mapLabel}</a>
        </div>
        <div>
          <h3 class="font-semibold">{t.info.hoursTitle}</h3>
          <ul class="mt-3 grid gap-1 text-muted">{t.info.hours.map((h) => <li>{h}</li>)}</ul>
        </div>
        <div>
          <h3 class="font-semibold">{t.info.contactTitle}</h3>
          <ul class="mt-3 grid gap-1 text-muted">
            <li><a href="tel:+34600000000" class="hover:text-ink">+34 600 000 000</a></li>
            <li><a href="mailto:visites@masalbareda.cat" class="hover:text-ink">visites@masalbareda.cat</a></li>
            <li>@cellermasalbareda</li>
          </ul>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-line py-10">
    <div class="container-x flex flex-wrap items-center justify-between gap-4 text-sm text-muted">
      <ul class="flex flex-wrap gap-4">{t.footer.legal.map((l) => <li><a href="#" class="hover:text-ink">{l}</a></li>)}</ul>
      <ObrimBadge lang={lang} />
    </div>
    <p class="container-x mt-6 text-xs text-muted/80">{t.footer.demo}</p>
  </footer>

  <WhatsAppButton message={t.whatsapp.message} label={t.whatsapp.label} />
</Base>
