---
import '../styles/global.css';
import SeoHead from '@obrim/ui/components/SeoHead.astro';
import { HTML_LANG, type Lang } from '@obrim/ui/i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>;
}

const { lang, title, description, jsonLd } = Astro.props;
---

<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <SeoHead
      lang={lang}
      title={title}
      description={description}
      site={Astro.site?.toString() ?? 'https://restaurant.obrim.cat'}
      siteName="Can Roure"
      themeColor="#3e6b4f"
      jsonLd={jsonLd}
    />
    <meta name="robots" content="noindex" />
  </head>
  <body class="min-h-dvh">
    <slot />
  </body>
</html>
