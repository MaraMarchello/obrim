---
import type { Dictionary } from '../i18n';

interface Props {
  t: Dictionary;
}
const { t } = Astro.props;
---

<section id="how" class="border-y border-line bg-ink py-16 text-paper sm:py-24">
  <div class="container-x">
    <p class="eyebrow !text-paper/60">{t.how.eyebrow}</p>
    <h2 class="h-section mt-3 max-w-2xl">{t.how.title}</h2>
    <ol class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        t.how.steps.map((step, i) => (
          <li class="border-t border-paper/20 pt-5">
            <span class="font-display text-3xl text-accent">0{i + 1}</span>
            <h3 class="mt-3 text-lg font-semibold">{step.title}</h3>
            <p class="mt-2 text-sm text-paper/70">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
