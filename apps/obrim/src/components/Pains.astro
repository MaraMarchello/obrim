---
import type { Dictionary } from '../i18n';

interface Props {
  t: Dictionary;
}
const { t } = Astro.props;
---

<section id="why" class="border-y border-line bg-surface py-16 sm:py-24">
  <div class="container-x">
    <p class="eyebrow">{t.pains.eyebrow}</p>
    <h2 class="h-section mt-3 max-w-2xl">{t.pains.title}</h2>
    <div class="mt-12 grid gap-8 md:grid-cols-3">
      {
        t.pains.items.map((item) => (
          <article class="border-t border-ink pt-6">
            <p class="font-display text-5xl font-semibold tracking-tight text-accent">{item.figure}</p>
            <p class="mt-1 text-sm text-muted">{item.unit}</p>
            <h3 class="mt-5 text-lg font-semibold">{item.title}</h3>
            <p class="mt-2 text-muted">{item.body}</p>
            {'source' in item && item.source && <p class="mt-3 text-xs text-muted/80">{item.source}</p>}
          </article>
        ))
      }
    </div>
  </div>
</section>
