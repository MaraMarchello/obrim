---
import LangSwitcher from '@obrim/ui/components/LangSwitcher.astro';
import { CONTACT } from '@obrim/ui/config';
import { localizePath, type Lang } from '@obrim/ui/i18n';
import type { Dictionary } from '../i18n';

interface Props {
  lang: Lang;
  t: Dictionary;
}
const { lang, t } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-paper py-12">
  <div class="container-x grid gap-10 md:grid-cols-[1.5fr_1fr_1fr]">
    <div>
      <p class="font-display text-2xl font-semibold">obrim<span class="text-accent">.</span></p>
      <p class="mt-2 max-w-xs text-sm text-muted">{t.footer.tagline}</p>
      <LangSwitcher current={lang} path="/" class="mt-6" />
    </div>
    <div class="text-sm">
      <p class="eyebrow">{t.footer.contact}</p>
      <ul class="mt-3 grid gap-2">
        <li><a href={`mailto:${CONTACT.email}`} class="hover:underline">{CONTACT.email}</a></li>
        <li><a href={`tel:+${CONTACT.whatsappNumber}`} class="hover:underline">{CONTACT.phoneDisplay}</a></li>
        <li><a href={`https://instagram.com/${CONTACT.instagram}`} target="_blank" rel="noopener" class="hover:underline">@{CONTACT.instagram}</a></li>
      </ul>
    </div>
    <div class="text-sm">
      <p class="eyebrow">{t.footer.legal}</p>
      <ul class="mt-3 grid gap-2">
        <li><a href={localizePath('/legal/avis-legal', lang)} class="hover:underline">{t.footer.legalLinks.notice}</a></li>
        <li><a href={localizePath('/legal/privacitat', lang)} class="hover:underline">{t.footer.legalLinks.privacy}</a></li>
        <li><a href={localizePath('/legal/cookies', lang)} class="hover:underline">{t.footer.legalLinks.cookies}</a></li>
      </ul>
    </div>
  </div>
  <div class="container-x mt-10 flex flex-wrap items-center justify-between gap-2 border-t border-line pt-6 text-xs text-muted">
    <span>© {year} {CONTACT.brand} · {CONTACT.founder.name}</span>
    <span>{t.footer.made}</span>
  </div>
</footer>
