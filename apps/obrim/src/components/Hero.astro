---
import type { Dictionary } from '../i18n';

interface Props {
  t: Dictionary;
}
const { t } = Astro.props;
---

<section class="container-x grid gap-10 py-16 sm:py-24 lg:grid-cols-[1.2fr_1fr] lg:items-center">
  <div>
    <p class="eyebrow">{t.hero.eyebrow}</p>
    <h1 class="h-display mt-4 max-w-3xl">{t.hero.title}</h1>
    <p class="mt-6 max-w-xl text-lg text-muted">{t.hero.subtitle}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="#audit" class="btn-primary">{t.hero.ctaPrimary}</a>
      <a href="#demos" class="btn-secondary">{t.hero.ctaSecondary}</a>
    </div>
    <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm text-muted">
      {
        t.hero.proofs.map((p) => (
          <li class="flex items-center gap-2">
            <span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-moss" />
            {p}
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Cartel "Obert": metáfora visual de la marca -->
  <div class="relative mx-auto w-full max-w-sm lg:max-w-none" aria-hidden="true">
    <div class="card relative overflow-hidden p-8 sm:p-10">
      <div class="absolute inset-x-0 top-0 h-1.5 bg-moss"></div>
      <p class="eyebrow">Gràcia · Barcelona</p>
      <p class="mt-6 font-display text-5xl font-semibold leading-none sm:text-6xl">
        OBERT<span class="text-accent">.</span>
      </p>
      <p class="mt-3 text-sm text-muted">24 h · 7 dies · 3 idiomes</p>
      <dl class="mt-8 grid grid-cols-3 gap-3 border-t border-line pt-6 text-sm">
        <div>
          <dt class="text-muted">Reserves</dt>
          <dd class="mt-1 font-semibold">0 € com.</dd>
        </div>
        <div>
          <dt class="text-muted">Mòbil</dt>
          <dd class="mt-1 font-semibold">&lt; 1 s</dd>
        </div>
        <div>
          <dt class="text-muted">Idiomes</dt>
          <dd class="mt-1 font-semibold">ca · es · en</dd>
        </div>
      </dl>
    </div>
  </div>
</section>
