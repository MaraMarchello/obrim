---
import type { Dictionary } from '../i18n';

interface Props {
  t: Dictionary;
}
const { t } = Astro.props;
---

<section id="faq" class="border-t border-line bg-surface py-16 sm:py-24">
  <div class="container-x grid gap-10 lg:grid-cols-[1fr_2fr]">
    <div>
      <p class="eyebrow">{t.faq.eyebrow}</p>
      <h2 class="h-section mt-3">{t.faq.title}</h2>
    </div>
    <div class="divide-y divide-line">
      {
        t.faq.items.map((item) => (
          <details class="group py-4">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-4 text-lg font-medium">
              <span>{item.q}</span>
              <span aria-hidden="true" class="mt-1 text-muted transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 max-w-2xl text-muted">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
