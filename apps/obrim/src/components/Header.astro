---
import LangSwitcher from '@obrim/ui/components/LangSwitcher.astro';
import { localizePath, type Lang } from '@obrim/ui/i18n';
import type { Dictionary } from '../i18n';

interface Props {
  lang: Lang;
  t: Dictionary;
}

const { lang, t } = Astro.props;
const home = localizePath('/', lang);
const links = [
  ['#why', t.nav.pains],
  ['#demos', t.nav.demos],
  ['#how', t.nav.how],
  ['#pricing', t.nav.pricing],
  ['#about', t.nav.about],
  ['#faq', t.nav.faq],
];
---

<header class="sticky top-0 z-30 border-b border-line/70 bg-paper/90 backdrop-blur">
  <div class="container-x flex h-16 items-center justify-between gap-4">
    <a href={home} class="font-display text-2xl font-semibold tracking-tight" aria-label="Obrim">
      obrim<span class="text-accent">.</span>
    </a>
    <nav class="hidden items-center gap-6 text-sm text-muted lg:flex" aria-label="Main">
      {links.map(([href, label]) => <a href={href} class="hover:text-ink">{label}</a>)}
    </nav>
    <div class="flex items-center gap-3">
      <LangSwitcher current={lang} path="/" class="hidden sm:flex" />
      <a href="#audit" class="btn-primary !px-4 !py-2">{t.nav.cta}</a>
    </div>
  </div>
</header>
