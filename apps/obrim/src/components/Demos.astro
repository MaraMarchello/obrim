---
import { CONTACT } from '@obrim/ui/config';
import { localizePath, type Lang } from '@obrim/ui/i18n';
import type { Dictionary } from '../i18n';

interface Props {
  lang: Lang;
  t: Dictionary;
}
const { lang, t } = Astro.props;

const demos = [
  { ...t.demos.restaurant, href: CONTACT.demos.restaurant + localizePath('/', lang), accent: '#3e6b4f', tag: 'Reserves · Comandes' },
  { ...t.demos.salon, href: CONTACT.demos.salon + localizePath('/', lang), accent: '#8a4b6b', tag: 'Cites' },
];
---

<section id="demos" class="container-x py-16 sm:py-24">
  <div class="max-w-2xl">
    <p class="eyebrow">{t.demos.eyebrow}</p>
    <h2 class="h-section mt-3">{t.demos.title}</h2>
    <p class="mt-4 text-muted">{t.demos.body}</p>
  </div>
  <div class="mt-12 grid gap-6 md:grid-cols-2">
    {
      demos.map((d) => (
        <article class="card flex flex-col overflow-hidden">
          <a href={d.href} target="_blank" rel="noopener" class="block bg-paper p-6" aria-label={`${t.demos.open}: ${d.name}`}>
            <div class="mx-auto w-44 rounded-[1.6rem] border-[6px] border-ink bg-surface p-3 text-[10px] leading-tight" aria-hidden="true">
              <div class="h-1 w-10 rounded-full bg-ink/20 mx-auto" />
              <p class="mt-3 font-display text-sm font-semibold" style={`color:${d.accent}`}>
                {d.name}
              </p>
              <p class="text-muted">{d.kind}</p>
              <div class="mt-3 h-14 rounded-lg" style={`background:${d.accent}22`} />
              <div class="mt-2 grid grid-cols-4 gap-1">
                {[0, 1, 2, 3].map((i) => (
                  <div class={`h-4 rounded ${i === 1 ? 'text-white' : 'bg-ink/5'}`} style={i === 1 ? `background:${d.accent}` : ''} />
                ))}
              </div>
              <div class="mt-2 h-6 rounded-full text-center text-[9px] font-semibold leading-6 text-white" style={`background:${d.accent}`}>
                {d.tag}
              </div>
            </div>
          </a>
          <div class="flex flex-1 flex-col p-6">
            <p class="eyebrow">{d.kind}</p>
            <h3 class="mt-1 font-display text-2xl">{d.name}</h3>
            <ul class="mt-4 grid gap-2 text-sm text-muted">
              {d.features.map((f) => (
                <li class="flex gap-2">
                  <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
                  {f}
                </li>
              ))}
            </ul>
            <a href={d.href} target="_blank" rel="noopener" class="btn-secondary mt-6 self-start">
              {t.demos.open} →
            </a>
          </div>
        </article>
      ))
    }
  </div>
</section>
