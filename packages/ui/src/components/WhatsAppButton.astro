---
import { whatsappLink } from '../config';

interface Props {
  number?: string;
  message: string;
  label: string;
}

const { number, message, label } = Astro.props;
const href = whatsappLink(message, number);
---

<a
  href={href}
  target="_blank"
  rel="noopener"
  aria-label={label}
  class="fixed bottom-5 right-5 z-40 inline-flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white transition-transform hover:scale-105 focus-visible:outline-white sm:bottom-6 sm:right-6"
>
  <svg viewBox="0 0 32 32" width="28" height="28" fill="currentColor" aria-hidden="true">
    <path
      d="M16 3C9.4 3 4 8.3 4 14.9c0 2.3.7 4.6 1.9 6.5L4 29l7.8-1.9c1.3.6 2.8 1 4.2 1 6.6 0 12-5.3 12-11.9S22.6 3 16 3zm0 21.7c-1.3 0-2.6-.3-3.8-1l-.3-.2-4.6 1.1 1.2-4.4-.2-.3c-1.1-1.6-1.7-3.5-1.7-5.4 0-5.3 4.3-9.6 9.6-9.6s9.6 4.3 9.6 9.6-4.4 10.2-9.8 10.2zm5.3-7.3c-.3-.1-1.7-.8-2-.9-.3-.1-.5-.1-.7.1-.2.3-.8.9-.9 1.1-.2.2-.3.2-.6.1-.3-.1-1.2-.5-2.3-1.4-.9-.8-1.5-1.7-1.6-2-.2-.3 0-.5.1-.6l.4-.5.3-.5c.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.7-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.1-.3-.2-.6-.3z"
    ></path>
  </svg>
</a>
